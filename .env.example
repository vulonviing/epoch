# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# ── Data mode ──────────────────────────────────────────────────────────
# "synthetic" (default, committed data/synthetic/) or "real" (your own
# gitignored data/real/, not shipped in this repository).
EPOCH_DATA_MODE=synthetic

# ── Named Backend (required for thesis-conformant LLM runs) ────────────
# Set to one of: opus48 | opus5 | sonnet46 | gpt55 | gpt56sol | gpt54mini
# When set, EPOCH_LLM_PROVIDER is ignored.
# When empty, falls back to EPOCH_LLM_PROVIDER (legacy path).
# `opus5` is the thesis reference configuration, not a bundled public service:
# replace it with a preset available in your own Azure/Foundry environment.
# Tests and release verification do not call an LLM backend.
EPOCH_LLM_BACKEND=opus5

# ── Azure OpenAI (gpt55 / gpt56sol / gpt54mini backends) ──────────────
# Endpoint: "https://<resource>.cognitiveservices.azure.com/"
EPOCH_AZURE_OPENAI_ENDPOINT=
EPOCH_AZURE_OPENAI_API_KEY=
EPOCH_AZURE_GPT56SOL_API_KEY=
# Per-backend reasoning_effort override (optional — preset default used if empty):
# EPOCH_BACKEND_GPT55_REASONING_EFFORT=xhigh
# EPOCH_BACKEND_GPT56SOL_REASONING_EFFORT=xhigh
# EPOCH_BACKEND_GPT54MINI_REASONING_EFFORT=medium

# ── Foundry — Anthropic / Claude Sonnet 4.6 (sonnet46 backend) ────────
# Endpoint: "https://<your-resource>.services.ai.azure.com/anthropic"
EPOCH_FOUNDRY_SONNET_BASE_URL=
EPOCH_FOUNDRY_SONNET_API_KEY=

# ── Foundry — Anthropic / Claude Opus 4.8 & Opus 5 (opus48 / opus5) ───
# Uses azure_ad auth (az login / managed identity) — no API key needed.
# EPOCH_FOUNDRY_ANTHROPIC_API_KEY is ignored when AUTH_TYPE=azure_ad.
# Same endpoint/key for both presets; opus5 only swaps the model id.
EPOCH_FOUNDRY_ANTHROPIC_API_KEY=
EPOCH_FOUNDRY_ANTHROPIC_MODEL=claude-opus-4-8
EPOCH_FOUNDRY_ANTHROPIC_BASE_URL=
EPOCH_FOUNDRY_ANTHROPIC_AUTH_TYPE=azure_ad

# ── Legacy provider (compatibility only) ─────────────────────────────
# Supported: openai | foundry_anthropic | (future) foundry_openai
# This path does not record explicit reasoning effort and therefore does not
# satisfy the thesis provenance rule for a completed LLM/Hybrid-agent run.
EPOCH_LLM_PROVIDER=foundry_anthropic

# ── OpenAI (legacy openai provider) ───────────────────────────────────
EPOCH_OPENAI_API_KEY=
EPOCH_OPENAI_MODEL=gpt-4o-mini
# EPOCH_OPENAI_BASE_URL=

# ── Per-agent model overrides (optional) ────────────────────────────────
# No agent is pinned by default -- every agent follows EPOCH_LLM_BACKEND.
# Set these only to point a specific agent at a different backend/model.
# EPOCH_R1_LLM_MODEL=
# EPOCH_DA1_LLM_MODEL=
# EPOCH_EX_LLM_MODEL=

# ── Tokens ─────────────────────────────────────────────────────────────
# config.py sizes every agent by output shape (Opus 5's adaptive thinking
# counts against max_tokens and runs heavier than Opus 4.8's did):
#   medium (32000) — per-batch analysts, small single-call agents
#   heavy  (64000) — single-call whole-portfolio/whole-table agents (F1, F2, R1, C2)
# Leave these unset so config.py's per-agent defaults apply. Pins below this
# global would silently undercut the heavy tier (R1/F1/F2/C2 need 64000, not 32000).
EPOCH_LLM_MAX_TOKENS=32000
# EPOCH_R1_MAX_TOKENS=
# EPOCH_R2_MAX_TOKENS=
# EPOCH_DA1_MAX_TOKENS=
# EPOCH_D1_MAX_TOKENS=
# EPOCH_D2_MAX_TOKENS=
# EPOCH_CP1_MAX_TOKENS=

# ── Shared settings ────────────────────────────────────────────────────
EPOCH_LLM_TEMPERATURE=0.0
